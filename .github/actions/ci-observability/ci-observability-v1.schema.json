    "BlastRadiusChange": {
      "additionalProperties": false,
      "description": "A file whose change now selects many more test files than before this PR.",
      "properties": {
        "path": {
          "title": "Path",
          "type": "string"
        },
        "before": {
          "title": "Before",
          "type": "integer"
        },
        "after": {
          "title": "After",
          "type": "integer"
        },
        "cause": {
          "items": {
            "$ref": "#/$defs/PathStep"
          },
          "title": "Cause",
          "type": "array"
        }
      },
      "required": [
        "path",
        "before",
        "after"
      ],
      "title": "BlastRadiusChange",
      "type": "object"
    },
    "ChangedFileReach": {
      "additionalProperties": false,
      "description": "One changed file's share of the selection: who loads it, and through what.\n\n`own` separates what the startup floor adds: the selected tests that would still load this\nfile if the floor's entries (root conftest, startup modules, package initializers every test\nloads) imported nothing. Outside the floor, the hub is the file most of the remaining indirect\nloaders depend on directly on their way to the change, such as a directory conftest or a URL\nconfiguration a policy attaches to every HTTP test. Tests that import the change directly are\nits real users.",
      "properties": {
        "path": {
          "title": "Path",
          "type": "string"
        },
        "tests": {
          "title": "Tests",
          "type": "integer"
        },
        "direct": {
          "title": "Direct",
          "type": "integer"
        },
        "own": {
          "title": "Own",
          "type": "integer"
        },
        "hub": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Hub"
        },
        "hub_tests": {
          "default": 0,
          "title": "Hub Tests",
          "type": "integer"
        },
        "hub_kind": {
          "anyOf": [
            {
              "enum": [
                "conftest",
                "hooks",
                "startup",
                "package",
                "import",
                "declared"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Hub Kind"
        }
      },
      "required": [
        "path",
        "tests",
        "direct",
        "own"
      ],
      "title": "ChangedFileReach",
      "type": "object"
    },
    "CollectionStatus": {
      "enum": [
        "complete",
        "partial",
        "unavailable"
      ],
      "title": "CollectionStatus",
      "type": "string"
    },
