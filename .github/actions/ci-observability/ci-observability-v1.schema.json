    "FloorCycle": {
      "additionalProperties": false,
      "description": "The floor's largest import cycle: every member reaches every other.\n\nWhile the cycle holds, a startup file that loads one member loads all of them, so trimming\nwhat startup loads leaves the whole cycle in the floor as long as any route into it remains.",
      "properties": {
        "size": {
          "title": "Size",
          "type": "integer"
        },
        "hub": {
          "title": "Hub",
          "type": "string"
        },
