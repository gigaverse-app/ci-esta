    "FullSuiteReferenceV1": {
      "additionalProperties": false,
      "description": "A measured run of the complete default gate, the baseline a narrowed run's saving is against.\n\nRecorded by the reporter of a green same-repository run whose change reached every test file,\nso nothing forced the full suite (coverage, a schedule, a label). Read back as the median of\nthe newest few whose suite size matches.",
      "properties": {
        "timings": {
          "$ref": "#/$defs/PytestTimingMetadata"
        },
        "total_files": {
          "minimum": 1,
          "title": "Total Files",
          "type": "integer"
        },
        "run_id": {
          "title": "Run Id",
          "type": "integer"
        },
        "head_branch": {
          "title": "Head Branch",
          "type": "string"
        },
        "recorded_at": {
          "format": "date-time",
          "title": "Recorded At",
          "type": "string"
        }
      },
      "required": [
        "timings",
        "total_files",
        "run_id",
        "head_branch",
        "recorded_at"
      ],
      "title": "FullSuiteReferenceV1",
      "type": "object"
    },
