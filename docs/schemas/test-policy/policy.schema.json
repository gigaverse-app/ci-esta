{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$defs": {
    "Profile": {
      "additionalProperties": false,
      "description": "A permitted occasion, selection scope and effect ceiling.\n\nIncludes are tags. An empty include set selects no work; '*' selects every\ntag, but still cannot override environment or side-effect constraints.",
      "properties": {
        "occasions": {
          "items": {
            "enum": [
              "pr",
              "push",
              "schedule",
              "deployment",
              "manual"
            ],
            "type": "string"
          },
          "title": "Occasions",
          "type": "array",
          "uniqueItems": true
        },
        "include": {
          "items": {
            "maxLength": 300,
            "minLength": 1,
            "pattern": "^[^\\r\\n]+$",
            "type": "string"
          },
          "title": "Include",
          "type": "array",
          "uniqueItems": true
        },
        "scope": {
          "default": "affected",
          "enum": [
            "affected",
            "all",
            "explicit"
          ],
          "title": "Scope",
          "type": "string"
        },
        "allow_effects": {
          "default": [],
          "items": {
            "maxLength": 300,
            "minLength": 1,
            "pattern": "^[^\\r\\n]+$",
            "type": "string"
          },
          "title": "Allow Effects",
          "type": "array",
          "uniqueItems": true
        },
        "environments": {
          "default": [],
          "items": {
            "maxLength": 300,
            "minLength": 1,
            "pattern": "^[^\\r\\n]+$",
            "type": "string"
          },
          "title": "Environments",
          "type": "array",
          "uniqueItems": true
        },
        "require_deployment": {
          "default": false,
          "title": "Require Deployment",
          "type": "boolean"
        },
        "fresh": {
          "default": false,
          "title": "Fresh",
          "type": "boolean"
        },
        "budget_seconds": {
          "anyOf": [
            {
              "exclusiveMinimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Budget Seconds"
        },
        "reserve_seconds": {
          "default": 0,
          "minimum": 0,
          "title": "Reserve Seconds",
          "type": "integer"
        }
      },
      "required": [
        "occasions",
        "include"
      ],
      "title": "Profile",
      "type": "object"
    },
    "Work": {
      "additionalProperties": false,
      "description": "An atomic suite or individual test. The adapter chooses the granularity.\n\nA conformance suite is one unit: admission must never split its validators\nfrom its tests. IDs and tags are data, never executable command strings.",
      "properties": {
        "id": {
          "maxLength": 300,
          "minLength": 1,
          "pattern": "^[^\\r\\n]+$",
          "title": "Id",
          "type": "string"
        },
        "tags": {
          "default": [],
          "items": {
            "maxLength": 300,
            "minLength": 1,
            "pattern": "^[^\\r\\n]+$",
            "type": "string"
          },
          "title": "Tags",
          "type": "array",
          "uniqueItems": true
        },
        "effects": {
          "default": [],
          "items": {
            "maxLength": 300,
            "minLength": 1,
            "pattern": "^[^\\r\\n]+$",
            "type": "string"
          },
          "title": "Effects",
          "type": "array",
          "uniqueItems": true
        },
        "environment": {
          "anyOf": [
            {
              "maxLength": 300,
              "minLength": 1,
              "pattern": "^[^\\r\\n]+$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Environment"
        },
        "fresh": {
          "default": false,
          "title": "Fresh",
          "type": "boolean"
        },
        "timeout_seconds": {
          "anyOf": [
            {
              "exclusiveMinimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Timeout Seconds"
        }
      },
      "required": [
        "id"
      ],
      "title": "Work",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "ci-esta/test-policy/v1",
      "default": "ci-esta/test-policy/v1",
      "title": "Schema Version",
      "type": "string"
    },
    "profiles": {
      "patternProperties": {
        "^[^\\r\\n]+$": {
          "$ref": "#/$defs/Profile"
        }
      },
      "propertyNames": {
        "maxLength": 300,
        "minLength": 1
      },
      "title": "Profiles",
      "type": "object"
    },
    "work": {
      "default": [],
      "items": {
        "$ref": "#/$defs/Work"
      },
      "title": "Work",
      "type": "array"
    }
  },
  "required": [
    "profiles"
  ],
  "title": "Policy",
  "type": "object"
}
